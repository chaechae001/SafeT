 "items": [
  {
   "id": "V01",
   "text": "오늘 점심 장사 때 튀김기로 오징어를 튀겼어요.",
   "audio_s": 4.37,
   "stt_seconds": 1.185
  },
  {
   "id": "V02",
   "text": "튀김기 기름 온도를 170도로 맞추고 새우를 넣습니다.",
   "audio_s": 4.91,
   "stt_seconds": 0.529
  },
  {
   "id": "V03",
   "text": "아침마다 튀김기를 예열해 둡니다.",
   "audio_s": 3.19,
   "stt_seconds": 0.593
  },
  {
   "id": "V04",
   "text": "감자튀김은 주문 들어올 때마다 바로 튀겨냅니다.",
   "audio_s": 4.16,
   "stt_seconds": 0.543
  },
  {
   "id": "V05",
   "text": "튀김기 바구니를 흔들어 기름을 터려요.",
   "audio_s": 3.32,
   "stt_seconds": 0.581
  },
  {
   "id": "V06",
   "text": "저녁엔 튀김기 두 대를 다 돌립니다.",
   "audio_s": 3.41,
   "stt_seconds": 0.501
  },
  {
   "id": "V07",
   "text": "튀김기 옆에서 반죽을 묻혀서 바로 넣어요.",
   "audio_s": 3.82,
   "stt_seconds": 0.52
  },
  {
   "id": "V08",
   "text": "튀김옷 입힌 닭을 기름에 넣고 오픈 튀깁니다.",
   "audio_s": 4.15,
   "stt_seconds": 0.557
  },
  {
   "id": "V09",
   "text": "튀김기 필터 청소는 주말에 하고 평일엔 계속 씁니다.",
   "audio_s": 4.75,
   "stt_seconds": 0.541
  },
  {
   "id": "V10",
   "text": "탕수육 튀길 때 기름이 많이 튀어요.",
   "audio_s": 3.31,
   "stt_seconds": 0.515
  },
  {
   "id": "V11",
   "text": "튀김기 쓰다가 손을 대인 적이 있어요.",
   "audio_s": 3.38,
   "stt_seconds": 0.497
  },
  {
   "id": "V12",
   "text": "바쁜 시간에는 튀김기를 쉬지 않고 돌려요.",
   "audio_s": 3.92,
   "stt_seconds": 0.504
  },
  {
   "id": "V13",
   "text": "돈가스는 두 번 튀겨서 나갑니다.",
   "audio_s": 3.29,
   "stt_seconds": 0.508
  },
  {
   "id": "V14",
   "text": "튀김 담당이 하루종일 튀김기 앞에 있어요.",
   "audio_s": 3.92,
   "stt_seconds": 0.504
  },
  {
   "id": "V15",
   "text": "고로케를 튀김기에 넣고 타이머를 맞춥니다.",
   "audio_s": 3.9,
   "stt_seconds": 0.521
  },
  {
   "id": "V16",
   "text": "저희는 튀김 메뉴를 작년에 없앴어요.",
   "audio_s": 3.65,
   "stt_seconds": 0.525
  },
  {
   "id": "V17",
   "text": "튀김기는 창고에 넣어놨어요.",
   "audio_s": 2.96,
   "stt_seconds": 0.496
  },
  {
   "id": "V18",
   "text": "튀김기 코드를 뽑아두었습니다.",
   "audio_s": 2.9,
   "stt_seconds": 0.542
  },
  {
   "id": "V19",
   "text": "튀김은 본사에서 완제품으로 받아서 데우기만 해요.",
   "audio_s": 4.36,
   "stt_seconds": 0.521
  },
  {
   "id": "V20",
   "text": "튀김기를 아예 지웠습니다.",
   "audio_s": 2.67,
   "stt_seconds": 0.496
  },
  {
   "id": "V21",
   "text": "튀김 요리는 안 팔아요.",
   "audio_s": 2.35,
   "stt_seconds": 0.492
  },
  {
   "id": "V22",
   "text": "튀김기는 이제 사용 안합니다.",
   "audio_s": 2.96,
   "stt_seconds": 0.481
  },
  {
   "id": "V23",
   "text": "튀김 작업은 하지 않고 볶음 위주로 해요.",
   "audio_s": 3.65,
   "stt_seconds": 0.503
  },
  {
   "id": "V24",
   "text": "튀김기 가스 밸브를 잠가 두고 앉습니다.",
   "audio_s": 3.75,
   "stt_seconds": 0.511
  },
  {
   "id": "V25",
   "text": "튀김기 그건 고장이라 그냥 둬요.",
   "audio_s": 3.14,
   "stt_seconds": 0.505
  },
  {
   "id": "V26",
   "text": "기름에 튀기는 일은 저의 가게에선 안해요.",
   "audio_s": 3.64,
   "stt_seconds": 0.511
  },
  {
   "id": "V27",
   "text": "튀김기가 하나 있는데 손님이 없어서 놀리고 있어요.",
   "audio_s": 4.26,
   "stt_seconds": 0.51
  },
  {
   "id": "V28",
   "text": "튀김기는 전원을 꺼놨어요.",
   "audio_s": 2.77,
   "stt_seconds": 0.492
  },
  {
   "id": "V29",
   "text": "튀김 메뉴는 이번 달부터 중단했어요.",
   "audio_s": 3.71,
   "stt_seconds": 0.5
  },
  {
   "id": "V30",
   "text": "요즘은 튀김을 전혀 안 튀겨요.",
   "audio_s": 3.03,
   "stt_seconds": 0.502
  },
  {
   "id": "V31",
   "text": "튀김기는 철거해서 지금 없어요.",
