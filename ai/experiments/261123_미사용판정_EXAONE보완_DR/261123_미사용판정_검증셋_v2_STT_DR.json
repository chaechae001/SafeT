  {
   "id": "V35",
   "text": "튀김기는 덥게 씌워서 보관 중입니다.",
   "audio_s": 3.56,
   "stt_seconds": 0.503
  },
  {
   "id": "V36",
   "text": "튀김기 온도계가 고장 났는데 그냥 쓰고 있어요.",
   "audio_s": 4.23,
   "stt_seconds": 0.514
  },
  {
   "id": "V37",
   "text": "튀김기 근처에 소화기가 없어요.",
