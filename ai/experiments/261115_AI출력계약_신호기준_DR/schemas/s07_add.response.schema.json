{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-t.local/schemas/s07_add.response.schema.json",
  "title": "S07 선택한 항목 추가 응답",
  "description": "S04 항목과 같은 RiskItemAI 형식. item_key는 요청의 candidate_key와 같게 둔다. 신호 판단 실패 항목은 off(판단 필요)로 넣는다(24쪽).",
  "type": "object",
  "required": ["request_id", "call", "status"],
  "properties": {
    "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
    "call": { "const": "s07_add" },
    "status": { "type": "string", "enum": ["ok", "partial", "failed"] }
  },
  "if": { "properties": { "status": { "const": "failed" } } },
  "then": {
    "required": ["error"],
    "properties": { "request_id": true, "call": true, "status": true, "error": { "$ref": "common.schema.json#/$defs/ErrorBody" } },
    "additionalProperties": false
  },
  "else": {
    "required": ["model_version", "criteria_version", "generated_at", "items"],
    "properties": {
      "request_id": true, "call": true, "status": true,
      "model_version": { "type": "string" },
      "criteria_version": { "type": ["string", "null"] },
      "generated_at": { "$ref": "common.schema.json#/$defs/IsoDateTime" },
      "items": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/RiskItemAI" } }
    },
    "additionalProperties": false
  }
}
