{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-t.local/schemas/s05d_expected_signal.request.schema.json",
  "title": "S05-D 개선 후 예상 신호 판단 요청",
  "description": "결정 5·21·25쪽. 평가표 저장(trigger=save) 또는 확정(trigger=confirm) 때 한 번에 호출한다. 지난 판단 이후 대책이 바뀐 항목과 아직 판단하지 않은 항목만 보낸다. 바뀐 항목이 없으면 호출하지 않고 데이터만 저장한다(원형 로딩만). 대상: 대책이 1개 이상인 빨강·노랑, green_choice=add이면서 대책이 있는 초록.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "assessment_id", "trigger", "items"],
  "properties": {
    "request_id": { "$ref": "common.schema.json#/$defs/RequestId" },
    "assessment_id": { "type": "string" },
    "trigger": { "type": "string", "enum": ["save", "confirm"] },
    "criteria_version": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "allOf": [{ "$ref": "common.schema.json#/$defs/ItemContext" }],
        "required": ["planned_measures"],
        "properties": {
          "green_choice": { "type": ["string", "null"], "enum": ["keep", "add", null] },
          "planned_measures": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/PlannedMeasure" },
            "description": "선택한 추천 대책 + 직접 추가 대책."
          }
        }
      }
    }
  }
}
