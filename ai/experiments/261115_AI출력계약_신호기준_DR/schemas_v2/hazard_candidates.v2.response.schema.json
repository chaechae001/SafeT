{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-t.local/schemas/v2/hazard_candidates.v2.response.schema.json",
  "title": "(b) 기기별 위험요인 후보 응답 (LLM 서비스 → 백엔드)",
  "description": "LLM은 후보만 추천한다. 후보마다 출처 ID·사고 유형·추천 근거 문장·예방대책 후보를 넣는다. 신호·위험도·발생 가능성·중대성은 넣지 않는다(ForbiddenJudgementFields). 출처를 찾지 못한 후보는 버린다. 모든 후보는 미선택으로 화면에 나간다.",
  "type": "object",
  "required": ["request_id", "call", "status"],
  "properties": {
    "request_id": { "$ref": "common.v2.schema.json#/$defs/RequestId" },
    "call": { "const": "hazard_candidates_v2" },
    "status": { "type": "string", "enum": ["ok", "partial", "failed"] }
  },
  "if": { "properties": { "status": { "const": "failed" } } },
  "then": {
    "required": ["error"],
    "properties": { "request_id": true, "call": true, "status": true, "error": { "$ref": "common.v2.schema.json#/$defs/ErrorBody" } },
    "additionalProperties": false
  },
  "else": {
    "required": ["model_version", "kb_version", "generated_at", "groups"],
    "properties": {
      "request_id": true, "call": true, "status": true,
      "model_version": { "type": "string", "minLength": 1 },
      "kb_version": { "type": "string" },
      "generated_at": { "$ref": "common.v2.schema.json#/$defs/IsoDateTime" },
      "groups": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["equipment_id", "display_name", "group_status", "candidates"],
          "properties": {
            "equipment_id": { "oneOf": [{ "$ref": "common.v2.schema.json#/$defs/EquipmentId" }, { "type": "null" }] },
            "display_name": { "type": "string" },
            "group_status": {
              "type": "string",
              "enum": ["ok", "no_source_found", "failed"],
              "description": "no_source_found=근거 자료가 없어 후보 없음(사용자 직접 추가로 진행). failed=이 기기만 생성 실패(재시도 제공)"
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "allOf": [{ "$ref": "common.v2.schema.json#/$defs/ForbiddenJudgementFields" }],
                "required": ["candidate_id", "hazard", "accident_type", "rationale", "source_refs", "measure_candidates"],
                "properties": {
                  "candidate_id": { "type": "string", "minLength": 1 },
                  "work": { "type": ["string", "null"], "description": "관련 작업(예: 튀김 조리). 없으면 null" },
                  "hazard": { "type": "string", "minLength": 1, "maxLength": 120, "description": "위험요인 문구(위험한 상황과 결과)" },
                  "accident_type": { "$ref": "common.v2.schema.json#/$defs/AccidentType" },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300,
                    "description": "추천 근거 문장. source_refs의 내용을 요약하며, 출처에 없는 사실을 만들지 않는다. 위험 정도 판단 문구(높다·낮다)는 쓰지 않는다"
                  },
                  "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "common.v2.schema.json#/$defs/SourceRef" } },
                  "measure_candidates": {
                    "type": "array",
                    "items": { "$ref": "common.v2.schema.json#/$defs/MeasureCandidate" },
                    "description": "예방대책 후보. 개수 고정 없음(v3.19의 '추천 3개'와 다름, 팀 결정 필요). 처음엔 모두 미선택"
                  },
                  "laws": { "type": "array", "items": { "$ref": "common.v2.schema.json#/$defs/LawRef" } }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "group_status": { "const": "ok" } } },
              "then": { "properties": { "candidates": { "minItems": 1 } } },
              "else": { "properties": { "candidates": { "maxItems": 0 } } }
            }
          ]
        }
      }
    },
    "additionalProperties": false
  }
}
