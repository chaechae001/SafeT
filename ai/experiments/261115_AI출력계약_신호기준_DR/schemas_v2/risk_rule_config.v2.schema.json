{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-t.local/schemas/v2/risk_rule_config.v2.schema.json",
  "title": "(d-1) 위험도 계산 규칙 설정",
  "description": "발생 가능성·중대성 척도와 위험도 계산·구간 규칙을 담는 설정 파일 형식. 값은 팀·전문가가 정하고 adoption_status=adopted인 설정만 운영에 쓴다. 각 등급·구간에 근거(source)를 붙인다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scale_id", "scale_version", "adoption_status", "method", "likelihood_levels", "severity_levels", "bands"],
  "properties": {
    "scale_id": { "type": "string", "minLength": 1 },
    "scale_version": { "type": "string", "minLength": 1 },
    "adoption_status": {
      "type": "string",
      "enum": ["guide_example_not_adopted", "proposed", "adopted"],
      "description": "guide_example_not_adopted=안내서 예시를 옮긴 것(운영 금지). adopted만 운영 계산에 쓴다"
    },
    "adopted_by": { "type": ["string", "null"], "description": "채택한 회의·전문가 기록 ID" },
    "adopted_at": { "type": ["string", "null"], "format": "date" },
    "method": {
      "type": "string",
      "enum": ["product", "sum", "matrix_lookup"],
      "description": "가능성과 중대성 조합 방법. 안내서는 곱셈·덧셈·행렬을 모두 허용(23년 안내서 60쪽)"
    },
    "likelihood_levels": { "$ref": "#/$defs/Levels" },
    "severity_levels": { "$ref": "#/$defs/Levels" },
    "matrix": {
      "type": ["array", "null"],
      "description": "method=matrix_lookup일 때 [가능성 index][중대성 index] = 위험도 점수",
      "items": { "type": "array", "items": { "type": "integer" } }
    },
    "bands": {
      "type": "array",
      "minItems": 2,
      "description": "위험도 점수 구간. 겹치거나 빈 구간이 없어야 한다(서버 검사)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min_score", "max_score", "band_code", "label", "tolerable", "action", "source"],
        "properties": {
          "min_score": { "type": "integer" },
          "max_score": { "type": "integer" },
          "band_code": { "type": "string", "pattern": "^[a-z_]+$" },
          "label": { "type": "string" },
          "tolerable": { "type": "boolean" },
          "action": { "type": "string", "description": "개선 방법 문구(예: 개선책 마련·이행)" },
          "signal": {
            "type": ["string", "null"],
            "enum": ["red", "yellow", "green", null],
            "description": "v3.19 신호등을 유지할 때만 쓰는 구간→색 대응. 대응 근거가 없으면 null(팀 결정 필요)"
          },
          "source": { "$ref": "#/$defs/GuideSource" }
        }
      }
    },
    "severity_overrides": {
      "type": ["array", "null"],
      "description": "선택 항목(2026-11-16 추가). 점수 구간을 정한 뒤 중대성 등급이 일치하면 구간을 덮어쓴다(예: 중대성 3이면 점수와 관계없이 빨강). 위에서부터 처음 일치한 항목 하나만 적용한다. 없거나 null이면 점수 구간만 쓴다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity_level", "band_code", "label", "tolerable", "action", "source"],
        "properties": {
          "severity_level": { "type": "integer", "minimum": 1 },
          "band_code": { "type": "string", "pattern": "^[a-z_]+$" },
          "label": { "type": "string" },
          "tolerable": { "type": "boolean" },
          "action": { "type": "string" },
          "signal": { "type": ["string", "null"], "enum": ["red", "yellow", "green", null] },
          "source": { "$ref": "#/$defs/GuideSource" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "GuideSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc", "printed_page", "pdf_page"],
      "properties": {
        "doc": { "type": "string" },
        "printed_page": { "type": ["integer", "null"] },
        "pdf_page": { "type": ["integer", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "Levels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "label", "criteria", "source"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "criteria": { "type": "string", "description": "사용자에게 보여줄 판단 기준 문구" },
          "source": { "$ref": "#/$defs/GuideSource" }
        }
      }
    }
  }
}
