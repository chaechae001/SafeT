{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safe-t.local/schemas/v2_1/risk_result.v2_1.schema.json",
  "title": "(d) 위험도 계산 결과 (백엔드 정책 → 화면)",
  "description": "백엔드 risk_policy.evaluate 결과를 항목·단계별로 담는다. AI(LLM)는 관여하지 않는다. 피해 S1~S3(카탈로그) × 조치 구간 C1~C3 → 상·중·하. 미응답이면 needs_information·N. 예상(expected)은 계획 이행을 가정한 값이며 현재 결과를 바꾸지 않는다. 근거: SafeT backend/domain/risk_policy.py · docs/implementation/catalog-risk.md (main 1daa5d8, #10)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "computed_by",
    "policy_version",
    "computed_at",
    "results"
  ],
  "properties": {
    "assessment_id": {
      "type": "string"
    },
    "computed_by": {
      "const": "backend_risk_policy"
    },
    "policy_version": {
      "$ref": "common.v2_1.schema.json#/$defs/PolicyVersion"
    },
    "computed_at": {
      "$ref": "common.v2_1.schema.json#/$defs/IsoDateTime"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selection_id",
          "phase",
          "status",
          "catalog_scenario_id",
          "severity",
          "control_band",
          "grade",
          "signal",
          "reason"
        ],
        "properties": {
          "selection_id": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": [
              "current",
              "expected"
            ],
            "description": "current=현재 조치 기준. expected=현재+계획 조치 이행 가정"
          },
          "status": {
            "type": "string",
            "enum": [
              "calculated",
              "needs_information",
              "not_in_catalog"
            ],
            "description": "not_in_catalog=시나리오가 없는 직접 추가 위험. 판단 필요로 표시"
          },
          "catalog_scenario_id": {
            "oneOf": [
              {
                "$ref": "common.v2_1.schema.json#/$defs/CatalogScenarioId"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              1,
              2,
              3,
              null
            ],
            "description": "카탈로그 피해 수준. 1 경미, 2 치료 필요, 3 사망·영구장해 가능"
          },
          "control_band": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              1,
              2,
              3,
              null
            ],
            "description": "1 필요한 조치 모두, 2 핵심 조치만, 3 핵심 조치 미선택"
          },
          "grade": {
            "$ref": "common.v2_1.schema.json#/$defs/Grade"
          },
          "signal": {
            "$ref": "common.v2_1.schema.json#/$defs/Signal"
          },
          "reason": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "calculated"
                }
              }
            },
            "then": {
              "properties": {
                "severity": {
                  "type": "integer"
                },
                "control_band": {
                  "type": "integer"
                },
                "grade": {
                  "type": "string"
                },
                "signal": {
                  "enum": [
                    "R",
                    "Y",
                    "G"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "control_band": {
                  "type": "null"
                },
                "grade": {
                  "type": "null"
                },
                "signal": {
                  "const": "N"
                }
              }
            }
          }
        ]
      }
    }
  }
}
