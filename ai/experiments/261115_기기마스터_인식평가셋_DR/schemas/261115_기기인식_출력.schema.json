{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safe-t/equipment_detection.response.v1-draft",
  "title": "S03 사진 기기 인식 응답(비전 모델 → 백엔드)",
  "description": "초안. 모델이 낸 원 결과다. '등록 기기 제외'와 ai_found 생성은 백엔드가 한다(261115_기기인식_출력형식_제외규칙_v1_DR.md 3절).",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "status", "master_version", "model_version", "judged_at", "photos", "detections"],
  "properties": {
    "request_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ok", "partial", "failed", "no_photo"],
      "description": "ok: 모든 사진 분석 성공. partial: 일부 사진 실패. failed: 전부 실패 또는 호출 실패. no_photo: 사진 없음. failed·no_photo면 detections는 빈 배열이어야 한다."
    },
    "error_code": { "type": ["string", "null"], "description": "failed일 때 원인 코드(timeout, invalid_image, model_error 등)." },
    "master_version": { "type": "string", "description": "인식에 쓴 기기 마스터 버전. 백엔드 마스터와 다르면 결과를 쓰지 않는다." },
    "model_version": { "type": "string" },
    "judged_at": { "type": "string", "format": "date-time" },
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["photo_id", "status"],
        "properties": {
          "photo_id": { "type": "string" },
          "status": { "type": "string", "enum": ["analyzed", "failed"] },
          "error_code": { "type": ["string", "null"] }
        }
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["detection_id", "photo_id", "equipment_id", "confidence", "bbox"],
        "properties": {
          "detection_id": { "type": "string", "description": "응답 안에서 고유. detection_refs는 'photo_id#detection_id'로 만든다." },
          "photo_id": { "type": "string" },
          "equipment_id": {
            "type": ["string", "null"],
            "pattern": "^EQ_[A-Z0-9_]+$",
            "description": "기기 마스터의 equipment_id. 마스터에 없는 물체는 null로 두고 raw_label에 이름을 적는다."
          },
          "raw_label": { "type": ["string", "null"], "description": "모델이 본 이름(로그·오류 분석용). 화면에 쓰지 않는다." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1, "description": "모델 점수. 보정(calibration) 여부를 model_version 문서에 적는다." },
          "bbox": {
            "type": ["array", "null"],
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "minItems": 4,
            "maxItems": 4,
            "description": "[x0, y0, x1, y1], EXIF 회전 적용 화면 기준 0-1 정규화. 모델이 영역을 못 내면 null."
          },
          "evidence_note": { "type": ["string", "null"], "maxLength": 200, "description": "판단 근거 짧은 설명(예: '튀김 바스켓과 유조'). 선택." }
        }
      }
    }
  }
}
