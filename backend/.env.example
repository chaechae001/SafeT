# Safe-T 백엔드 환경변수 예시
# 사용법: 이 파일을 복사해 같은 폴더에 .env 로 만들고 값을 채웁니다.
#   copy backend\.env.example backend\.env
# .env 는 .gitignore 에 있어 GitHub 에 올라가지 않습니다. 비밀번호는 .env 에만 적습니다.

# MariaDB (로컬 Docker 컨테이너 기준)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=safeT
DB_USER=root
DB_PASSWORD=

# 메일 발송 (회원가입 인증 코드)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls
#        SMTP_PASSWORD 는 계정 비밀번호가 아니라 '앱 비밀번호'(Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람 주소 (비우면 SMTP_USER)
SMTP_FROM=

# 화면에서 API 를 부를 수 있게 허용할 주소 (쉼표로 구분). 비우면 아래 기본값
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 로그인 토큰(JWT) 서명용 비밀키. 32자 이상 임의 문자열 (사람·PC마다 달라도 됨, 절대 공유·커밋 금지)
# 만들기: backend\.venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# 토큰 유효 시간(분). 기본 480분(8시간)
JWT_EXPIRE_MINUTES=480

# 자동 테스트(backend/tests) 실행 허락. 테스트는 이 .env 의 DB 에 테스트 데이터를 넣었다가 지웁니다.
# DB 이름이 _test 로 끝나면 비워 둬도 실행됩니다. 개인 로컬 DB 를 그대로 쓸 때만 1 로 바꾸세요.
# 팀 공용·운영 DB 를 가리킬 때는 절대 1 로 두지 마세요.
ALLOW_DB_TESTS=

# Cloud 없이 DB 시나리오·조치로 계산. run_local.py --catalog 로도 활성화 가능.
# catalog_v1 / demo(기존 고정 시험값) / unavailable
SAFET_ASSESSMENT_MODE=unavailable
