# Safe-T 백엔드 환경변수 예시
# 사용법: 이 파일을 복사해 같은 폴더에 .env 로 만들고 값을 채웁니다.
#   copy backend\.env.example backend\.env
# .env 는 .gitignore 에 있어 GitHub 에 올라가지 않습니다. 비밀번호는 .env 에만 적습니다.

# MariaDB (로컬 Docker 컨테이너 기준)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=safeT
DB_USER=root
DB_PASSWORD=

# 메일 발송 (회원가입 인증 코드)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls
#        SMTP_PASSWORD 는 계정 비밀번호가 아니라 '앱 비밀번호'(Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# 보내는 사람 주소 (비우면 SMTP_USER)
SMTP_FROM=

# 화면에서 API 를 부를 수 있게 허용할 주소 (쉼표로 구분). 비우면 아래 기본값
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 로그인 토큰(JWT) 서명용 비밀키. 32자 이상 임의 문자열 (사람·PC마다 달라도 됨, 절대 공유·커밋 금지)
# 만들기: backend\.venv\Scripts\python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# 토큰 유효 시간(분). 기본 480분(8시간)
JWT_EXPIRE_MINUTES=480

# 자동 테스트(backend/tests) 실행 허락. 테스트는 이 .env 의 DB 에 테스트 데이터를 넣었다가 지웁니다.
# DB 이름이 _test 로 끝나면 비워 둬도 실행됩니다. 개인 로컬 DB 를 그대로 쓸 때만 1 로 바꾸세요.
# 팀 공용·운영 DB 를 가리킬 때는 절대 1 로 두지 마세요.
ALLOW_DB_TESTS=

# Cloud 없이 DB 시나리오·조치로 계산. run_local.py --catalog 로도 활성화 가능.
# catalog_v1 / demo(기존 고정 시험값) / unavailable
SAFET_ASSESSMENT_MODE=unavailable

# 2026-11-17 AI 서버 담당자 배포 주소. 키는 서버 환경변수에만 설정합니다.
# AI 후보 분석 + 공통 정책: catalog_ai_v1 또는 run_local.py --ai
# GitHub 기록: EXAONE 3.5 7.8B Instruct AWQ. 실제 배포 model ID를 확인해 입력.
SAFET_AI_BASE_URL=https://gdqtaahjfkzgzzxr.tunnel.elice.io/proxy/8000/v1
SAFET_AI_MODEL=exaone-3.5-7.8b-instruct-awq
SAFET_AI_API_KEY=
SAFET_AI_MAX_TOKENS=1024
# 입력+출력+여유 64토큰 <=4096. 계수 실패 시 생성 요청 차단.
SAFET_AI_TOKENIZE_URL=https://gdqtaahjfkzgzzxr.tunnel.elice.io/proxy/8000/tokenize
# 사진 → SAM 3 탐지 JSON 변환 서버의 전체 요청 URL (요청 형식은 ai-integration.md 참고)
SAFET_DETECTOR_URL=https://gdqtaahjfkzgzzxr.tunnel.elice.io/proxy/8001/v1/detect
# 탐지 임계값. 0.35 = 평가셋 34장 비교에서 놓침을 덜 내는 값(F2 최고). 근거: ai/README.md.
# 0.05(배포 기본)는 사진 1장에 박스 평균 173개가 나와 AI 입력 한도를 넘습니다.
SAFET_DETECTOR_THRESHOLD=0.35
SAFET_DETECTOR_API_KEY=

# 문서 다운로드(결과서 PDF) 한글 폰트 TTF 경로. 비우면 Windows 맑은 고딕 → Linux 나눔고딕(fonts-nanum) 순서로 찾습니다.
# .otf(Noto CJK 등)는 읽지 못합니다.
REPORT_FONT_REGULAR=
REPORT_FONT_BOLD=

# 결과 공유: 받는 사람 화면 주소(링크·QR에 사용). 끝에 ?t=토큰이 붙습니다.
# 휴대폰으로 QR을 찍어 보려면 PC의 내부 IP 주소로 바꾸세요(예: http://192.168.0.10:8000/pages/share-download.html).
SHARE_BASE_URL=http://localhost:8000/pages/share-download.html

# 관문 주소를 설정하면 기존 개별 모델 주소보다 우선합니다.
SAFET_AI_GATEWAY_URL=https://gdqtaahjfkzgzzxr.tunnel.elice.io/proxy/8010
