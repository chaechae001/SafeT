{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safe-T ���� ��� ��� �ʾ�",
  "description": "���� ���� �� �� ���䰡 �ʿ��� ����� ����. ���� ���� ������ �ƴϴ�.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hazard_labels",
    "assessment_state",
    "objects",
    "image_text",
    "gas_leak_status"
  ],
  "properties": {
    "hazard_labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "slip",
          "cut",
          "burn",
          "fire",
          "gas",
          "electric",
          "chemical",
          "ergonomic",
          "falling",
          "respiratory"
        ]
      }
    },
    "assessment_state": {
      "enum": [
        "candidate",
        "insufficient_information",
        "out_of_scope"
      ]
    },
    "objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "oven",
          "microwave",
          "sink",
          "refrigerator",
          "gas_detector"
        ]
      }
    },
    "image_text": {
      "type": "string"
    },
    "gas_leak_status": {
      "const": "not_determinable"
    }
  },
  "if": {
    "properties": {
      "assessment_state": {
        "const": "candidate"
      }
    }
  },
  "then": {
    "properties": {
      "hazard_labels": {
        "minItems": 1
      }
    }
  },
  "else": {
    "properties": {
      "hazard_labels": {
        "maxItems": 0
      }
    }
  }
}
