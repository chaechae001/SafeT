              }
            }
          },
          "else": {
            "properties": {
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "route": {
                "const": "skipped"
              }
            }
          },
          "else": {
            "properties": {
              "route": {
                "not": {
                  "const": "skipped"
                }
              }
            }
          }
        }
      ]
    },
