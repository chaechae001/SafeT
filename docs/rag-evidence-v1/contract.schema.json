{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "safet-evidence/1.0.0"
        },
        "tag_version": {
          "const": "restaurant-tags/1.0.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "work_text": {
          "type": "string",
          "minLength": 1
        },
        "work_status": {
          "enum": [
            "supported",
            "unconfirmed",
            "denied"
          ]
        },
        "scenario_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "equipment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "process_tag": {
          "type": "array",
          "items": {
            "enum": [
              "move",
              "store",
              "carry",
              "hand_prep",
              "machine_prep",
              "cook",
              "oil_change",
              "serve",
              "wash",
              "clean",
              "maintain",
              "deliver",
              "customer",
              "manage"
            ]
          },
          "uniqueItems": true
        },
        "hazard_tag": {
          "type": "array",
          "items": {
            "enum": [
              "slip",
              "fall",
              "burn",
              "cut",
              "caught",
              "struck",
              "trapped",
              "msd",
              "poison",
              "asphyxia",
              "chemical_burn",
              "shock",
              "fire",
              "explosion",
              "heat_stress",
              "cold_stress",
              "radiation",
              "traffic",
              "psychosocial"
            ]
          },
          "uniqueItems": true
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        }
      },
      "required": [
        "contract_version",
        "tag_version",
        "request_id",
        "unit_id",
        "as_of",
        "work_text",
        "work_status",
        "scenario_id",
        "equipment_ids",
        "process_tag",
        "hazard_tag",
        "facts"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
