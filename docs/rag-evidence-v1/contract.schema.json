          "minLength": 1
        },
        "route": {
          "enum": [
            "vector",
            "skipped"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "no_evidence",
            "skipped",
            "error"
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
