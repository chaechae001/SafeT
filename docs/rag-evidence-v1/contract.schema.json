              "source_version": {
                "type": "string",
                "minLength": 1
              },
              "process_tag": {
                "type": "array",
                "items": {
                  "enum": [
                    "move",
                    "store",
                    "carry",
                    "hand_prep",
                    "machine_prep",
                    "cook",
                    "oil_change",
                    "serve",
                    "wash",
                    "clean",
                    "maintain",
                    "deliver",
                    "customer",
                    "manage"
                  ]
                },
                "uniqueItems": true
              },
              "hazard_tag": {
                "type": "array",
                "items": {
                  "enum": [
                    "slip",
                    "fall",
                    "burn",
                    "cut",
                    "caught",
                    "struck",
                    "trapped",
                    "msd",
                    "poison",
                    "asphyxia",
                    "chemical_burn",
                    "shock",
                    "fire",
                    "explosion",
                    "heat_stress",
                    "cold_stress",
                    "radiation",
                    "traffic",
                    "psychosocial"
                  ]
                },
                "uniqueItems": true
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "law_name": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(www\\.)?law\\.go\\.kr/"
              },
              "effective_from": {
                "type": "string",
                "format": "date"
              },
              "applicability": {
                "enum": [
                  "supported",
                  "conditional"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "missing_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "evidence_id",
              "source_version",
              "process_tag",
              "hazard_tag",
              "quote",
              "law_name",
              "locator",
              "url",
              "effective_from",
              "applicability",
              "reason",
              "missing_conditions"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "applicability": {
                      "const": "conditional"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "missing_conditions": {
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "missing_conditions": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "contract_version",
        "tag_version",
        "request_id",
        "unit_id",
        "module",
        "corpus_version",
        "route",
        "status",
        "error_code",
        "items"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "items": {
                "maxItems": 0
              }
            }
          }
        },
        {
